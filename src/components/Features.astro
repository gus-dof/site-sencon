---
import { GLOBE_DOTS } from './globe-dots'
const ARC = 'M86 272 C130 196 215 200 259 278'
---
<section class="section section--featv2">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">Funcionalidades</span>
      <h2>Nossa ferramenta foi pensada para todos os investidores.</h2>
      <p>Do investidor casual ao trader ativo — tudo o que você precisa em um só lugar.</p>
    </div>

    <div class="gsf-grid">
      <!-- 1 · IR para Exterior — dotted globe, NY → Lisboa arc, US$ → R$ conversion -->
      <article class="gsf-feat">
        <div class="gsf-canvas gsf-canvas--globe">
          <div class="gsf-fxbar">
            <div class="gsf-fx__route">
              <span class="gsf-chip">🇺🇸 US$ 1.000</span>
              <svg class="gsf-fx__arrow" viewBox="0 0 20 12" fill="none" aria-hidden="true"><path d="M1 6h16m0 0-4.5-4.5M17 6l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="gsf-chip gsf-chip--brl">🇧🇷 R$ <b data-gsf-count="5247">5.247</b></span>
            </div>
            <div class="gsf-fxsub">convertido pelo câmbio PTAX do dia</div>
          </div>
          <svg class="gsf-globe" viewBox="0 0 340 300" fill="none" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <circle class="gsf-globe__rim" cx="170" cy="330" r="210" />
            <path class="gsf-globe__dots" d={GLOBE_DOTS} />
            <path class="gsf-globe__arc" d={ARC} />
            <circle class="gsf-globe__comet" r="3.5" style={`offset-path: path('${ARC}');`} />
            <circle class="gsf-globe__end" cx="86" cy="272" r="3.5" />
            <circle class="gsf-globe__end gsf-globe__end--dst" cx="259" cy="279" r="3.5" />
            <circle class="gsf-globe__ping" cx="86" cy="272" r="8" />
            <circle class="gsf-globe__ping gsf-globe__ping--dst" cx="259" cy="279" r="8" />
          </svg>
        </div>
        <h4>IR para Exterior</h4>
        <p>Cálculo do imposto sobre investimentos fora do Brasil, com conversão de câmbio PTAX e suporte às principais corretoras internacionais.</p>
      </article>

      <!-- 2 · Cálculo 100% automático — steps resolve, DARF pill pops -->
      <article class="gsf-feat">
        <div class="gsf-canvas gsf-canvas--free">
          <div class="gsf-tasks" aria-hidden="true">
            <span class="gsf-task">
              <i class="gsf-task__check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
              12 notas importadas
            </span>
            <span class="gsf-task">
              <i class="gsf-task__check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
              Imposto apurado
            </span>
          </div>
          <div class="gsf-pill">DARF pronta · R$ 432,10</div>
        </div>
        <h4>Cálculo 100% automático</h4>
        <p>Esqueça as planilhas. Aqui na Sencon o cálculo do imposto é totalmente automatizado, importado e apurado mês a mês.</p>
      </article>

      <!-- 3 · Relatórios — dashboard card, self-drawing chart + KPI -->
      <article class="gsf-feat">
        <div class="gsf-canvas gsf-canvas--dash">
          <div class="gsf-dash">
            <div class="gsf-dash__bar">
              <div>
                <div class="gsf-dash__t">Evolução da carteira</div>
                <div class="gsf-dash__d">Lucro acumulado · 2026</div>
              </div>
              <span class="gsf-kpi">
                <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5m0 0H4.2m5.3 0v5.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                +24,8%
              </span>
            </div>
            <div class="gsf-dash__chart">
              <svg viewBox="0 0 640 210" fill="none" aria-hidden="true">
                <defs>
                  <linearGradient id="gsfAreaG" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" style="stop-color: var(--gsf-accent);" stop-opacity="0.20" />
                    <stop offset="1" style="stop-color: var(--gsf-accent);" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path class="gsf-hair" d="M18 58 H622" />
                <path class="gsf-hair" d="M18 110 H622" />
                <path class="gsf-hair" d="M18 162 H622" />
                <path class="gsf-area" d="M18 166 C80 152 110 158 150 142 C190 126 214 136 252 120 C290 104 318 114 356 94 C394 74 422 86 460 66 C498 46 560 52 622 32 L622 200 L18 200 Z" fill="url(#gsfAreaG)" />
                <path class="gsf-line" d="M18 166 C80 152 110 158 150 142 C190 126 214 136 252 120 C290 104 318 114 356 94 C394 74 422 86 460 66 C498 46 560 52 622 32" pathLength="100" />
                <circle class="gsf-ring" cx="622" cy="32" r="6" />
                <circle class="gsf-dot" cx="622" cy="32" r="5" />
              </svg>
              <div class="gsf-months" aria-hidden="true">
                <span>Jan</span><span>Mar</span><span>Mai</span><span>Jul</span><span>Set</span><span>Nov</span>
              </div>
            </div>
          </div>
        </div>
        <h4>Relatórios de resultados</h4>
        <p>Acompanhe lucro, prejuízo e DARFs emitidos em relatórios exclusivos e veja a evolução da sua carteira ao longo do tempo.</p>
      </article>
    </div>
  </div>
</section>

<script>
  // Choreographs each feature card when it scrolls into view (.is-in) and
  // runs the R$ count-up. Markup ships with final values, so no-JS and
  // reduced-motion users always see the finished composition.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const feats = document.querySelectorAll<HTMLElement>('.gsf-feat')
  if (feats.length && 'IntersectionObserver' in window) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3)
    const count = (el: HTMLElement) => {
      const target = parseInt(el.dataset.gsfCount || '0', 10)
      const dur = 1500
      let start: number | null = null
      const tick = (ts: number) => {
        if (start === null) start = ts
        const p = Math.min((ts - start) / dur, 1)
        el.textContent = Math.round(easeOut(p) * target).toLocaleString('pt-BR')
        if (p < 1) requestAnimationFrame(tick)
      }
      el.textContent = '0'
      requestAnimationFrame(tick)
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          io.unobserve(e.target)
          const el = e.target as HTMLElement
          el.classList.add('is-in')
          if (!reduced) {
            // start counting once the phone screen has settled
            el.querySelectorAll<HTMLElement>('[data-gsf-count]').forEach((n) => setTimeout(() => count(n), 550))
          }
        }
      },
      { threshold: 0.35, rootMargin: '0px 0px -8% 0px' },
    )
    feats.forEach((f) => io.observe(f))
  }
</script>
