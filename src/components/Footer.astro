---
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="wm wm--16">
          <!-- commemorative 16-anos signature — one asset per theme -->
          <img class="wm--16-neg" src="/assets/sencon-16-anos-negative.png" alt="Sencon · 16 anos" width="1995" height="732" />
          <img class="wm--16-pos" src="/assets/sencon-16-anos-positive.png" alt="Sencon · 16 anos" width="1995" height="732" />
        </div>
        <p>A primeira calculadora automática de Imposto de Renda sobre Renda Variável do Brasil. +16 anos cuidando do IR de 300 mil investidores.</p>
      </div>

      <div class="footer__col">
        <h5>Produtos</h5>
        <ul>
          <li><a href="/ir-b3">IR para Bolsa (B3)</a></li>
          <li><a href="/ir-exterior">IR para Exterior</a></li>
          <li><a href="#">IR para Cripto</a></li>
          <li><a href="#">Premium</a></li>
          <li><a href="#">Para Assessores</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h5>Empresa</h5>
        <ul>
          <li><a href="#">Sobre a Sencon</a></li>
          <li><a href="#">Carreira</a></li>
          <li><a href="#">Imprensa</a></li>
          <li><a href="#">Parcerias</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h5>Conteúdos</h5>
        <ul>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Central de ajuda</a></li>
          <li><a href="#">Guia da Declaração</a></li>
          <li><a href="#">Calendário do IR</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h5>Suporte</h5>
        <ul>
          <li><a href="#">Contato</a></li>
          <li><a href="#">WhatsApp</a></li>
          <li><a href="#">Status do sistema</a></li>
          <li><a href="#">Privacidade · LGPD</a></li>
          <li><a href="#">Termos de uso</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div>© 2026 Sencon. Todos os direitos reservados.</div>
      <div class="footer__socials">
        <a href="#" aria-label="LinkedIn" id="footer-social-linkedin">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
        </a>
        <a href="#" aria-label="Instagram" id="footer-social-instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="YouTube" id="footer-social-youtube">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.7-.5-5.5a2.8 2.8 0 0 0-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.5a2.8 2.8 0 0 0-2 2C1 8.3 1 12 1 12s0 3.7.5 5.5a2.8 2.8 0 0 0 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.5a2.8 2.8 0 0 0 2-2C23 15.7 23 12 23 12zM10 15.5v-7l6 3.5z"/></svg>
        </a>
        <a href="#" aria-label="X / Twitter" id="footer-social-x">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2H21l-6.55 7.49L22 22h-6.79l-5.32-6.96L3.8 22H1l7.02-8.02L1.5 2h6.92l4.8 6.34L18.244 2zm-1.18 18.32h1.88L7.05 3.6H5.04l12.02 16.72z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  var socialLinks = [
    { id: 'footer-social-linkedin', platform: 'linkedin' },
    { id: 'footer-social-instagram', platform: 'instagram' },
    { id: 'footer-social-youtube', platform: 'youtube' },
    { id: 'footer-social-x', platform: 'x' }
  ];
  socialLinks.forEach(function (item) {
    document.getElementById(item.id)?.addEventListener('click', function () {
      window.posthog?.capture('footer_social_clicked', { platform: item.platform });
    });
  });
</script>
