---
---
<section class="hero hero--centered">
  <!-- Background grain + grid -->
  <div class="hero__grain"></div>

  <!-- Animated beams along grid lines -->
  <div class="hero__beams" aria-hidden="true">
    <span class="hero__beam hero__beam--h hero__beam--1"></span>
    <span class="hero__beam hero__beam--h hero__beam--rev hero__beam--2"></span>
    <span class="hero__beam hero__beam--h hero__beam--3"></span>
    <span class="hero__beam hero__beam--h hero__beam--rev hero__beam--4"></span>
    <span class="hero__beam hero__beam--h hero__beam--5"></span>
    <span class="hero__beam hero__beam--v hero__beam--6"></span>
    <span class="hero__beam hero__beam--v hero__beam--rev hero__beam--7"></span>
    <span class="hero__beam hero__beam--v hero__beam--8"></span>
    <span class="hero__beam hero__beam--v hero__beam--rev hero__beam--9"></span>
    <span class="hero__beam hero__beam--v hero__beam--10"></span>
  </div>

  <!-- Copy -->
  <div class="container hero__centered-inner">
    <span class="eyebrow eyebrow--on-brand">+14 anos · pioneira no Brasil</span>

    <h1 class="hero__centered-title" style="font-weight: 700; width: 100%; max-width: 1040px;">
      Calculadora automática de Imposto<br />
      de Renda sobre Renda Variável,<br />
      <span class="hero__centered-title-accent">a primeira do Brasil.</span>
    </h1>

    <p class="hero__centered-sub">
      Mais de 14 anos de precisão e praticidade no cálculo do seu IR, agora com o Contador:
      o agente de inteligência artificial que responde suas dúvidas e executa tarefas por você.
    </p>

    <div class="hero__centered-cta">
      <a href="#produtos" class="btn btn--primary btn--lg" id="hero-cta-products">
        Conheça nossos produtos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="#planos" class="btn btn--ghost-dark btn--lg" id="hero-cta-plans">Ver planos</a>
    </div>

    <div class="hero__centered-trust">
      <span class="dot"></span>
      <span>300&nbsp;mil clientes · 20&nbsp;milhões de notas processadas · Em dia com a Receita&nbsp;Federal</span>
    </div>
  </div>

  <!-- App screenshot -->
  <div class="container hero__shot-wrap">
    <div class="hero__shot">
      <div class="mockup__chrome">
        <span class="dot r"></span>
        <span class="dot y"></span>
        <span class="dot g"></span>
        <span class="url">app.sencon.com.br / inicio</span>
      </div>
      <img
        src="/assets/home-sencon.png"
        alt="Painel da Sencon — Olá Gustavo, o que vamos fazer hoje?"
        loading="eager"
      />
    </div>
  </div>

<script is:inline>
  document.getElementById('hero-cta-products')?.addEventListener('click', function () {
    window.posthog?.capture('hero_cta_products_clicked');
  });
  document.getElementById('hero-cta-plans')?.addEventListener('click', function () {
    window.posthog?.capture('hero_cta_plans_clicked');
  });
</script>

  <!-- Corretoras strip -->
  <div class="container">
    <div class="corretoras corretoras--on-brand">
      <div class="corretoras__label">Conectado às principais corretoras do Brasil e do Exterior</div>
      <div class="corretoras__marquee">
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>XP</span>
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>BTG Pactual</span>
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>Inter</span>
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>Rico</span>
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>Clear</span>
        <span class="corretoras__item"><span class="corretoras__flag">B3</span>Genial</span>
        <span class="corretoras__item"><span class="corretoras__flag">EXT</span>Morgan Stanley</span>
        <span class="corretoras__item"><span class="corretoras__flag">EXT</span>Avenue</span>
        <span class="corretoras__item"><span class="corretoras__flag">EXT</span>Nomad</span>
        <span class="corretoras__item"><span class="corretoras__flag">EXT</span>Interactive Brokers</span>
        <span class="corretoras__item"><span class="corretoras__flag">EXT</span>Charles Schwab</span>
      </div>
    </div>
  </div>
</section>
