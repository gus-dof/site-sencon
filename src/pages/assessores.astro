---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Numbers from '../components/Numbers.astro'
import Footer from '../components/Footer.astro'
import FabWhats from '../components/FabWhats.astro'

const title = 'Sencon para Assessores e Contadores · IR de Renda Variável dos seus clientes'
const description =
  'Conquiste e fidelize mais clientes com a calculadora automática de Imposto de Renda da Sencon. Soluções completas para assessores e contadores que atendem investidores — DARF, declaração e relatórios de carteira. Planos a partir de R$ 24,00/mês por cliente.'

const benefits = [
  {
    title: 'Automatize DARF e Declaração',
    desc: 'Com poucos cliques você finaliza todo o IR sobre renda variável dos seus clientes: importe as notas de corretagem e a calculadora cuida do resto.',
    illo: 'auto',
  },
  {
    title: 'Fidelize seus clientes',
    desc: 'Acesse dados da carteira de cada cliente — lucro, taxas de corretagem e preço médio — e fidelize enviando esse acompanhamento todos os meses.',
    illo: 'reports',
  },
  {
    title: 'Suporte técnico especializado',
    desc: 'Ficou em dúvida ou seu cliente fez uma pergunta difícil? Conte com suporte especializado para te ajudar dentro da própria plataforma.',
    illo: 'support',
  },
]
---
<Layout title={title} description={description}>
  <Navbar />
  <main>
    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="hero hero--centered hero--page">
      <div class="hero__grain"></div>
      <div class="hero__beams" aria-hidden="true">
        <span class="hero__beam hero__beam--h hero__beam--1"></span>
        <span class="hero__beam hero__beam--h hero__beam--rev hero__beam--2"></span>
        <span class="hero__beam hero__beam--h hero__beam--3"></span>
        <span class="hero__beam hero__beam--h hero__beam--rev hero__beam--4"></span>
        <span class="hero__beam hero__beam--h hero__beam--5"></span>
        <span class="hero__beam hero__beam--v hero__beam--6"></span>
        <span class="hero__beam hero__beam--v hero__beam--rev hero__beam--7"></span>
        <span class="hero__beam hero__beam--v hero__beam--8"></span>
        <span class="hero__beam hero__beam--v hero__beam--rev hero__beam--9"></span>
        <span class="hero__beam hero__beam--v hero__beam--10"></span>
      </div>

      <div class="container hero__centered-inner">
        <span class="eyebrow eyebrow--on-brand">Para assessores e contadores</span>
        <h1 class="hero__centered-title" style="max-width: 1040px;">
          Conquiste e fidelize mais clientes com nossa
          <span class="hero__centered-title-accent">calculadora automática</span>.
        </h1>
        <p class="hero__centered-sub">
          Soluções completas para assessores e contadores que atendem investidores —
          do cálculo do DARF à declaração anual, com relatórios de carteira para
          encantar seus clientes.
        </p>
        <div class="hero__centered-cta">
          <a href="#planos" class="btn btn--primary btn--lg" id="adv-hero-cta">
            Quero conhecer
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="#" class="btn btn--whatsapp btn--lg" id="adv-hero-vendas">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3c.2.2 2.1 3.2 5.2 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4 0-.2-.3-.3-.6-.5zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
            Falar com vendas
          </a>
        </div>
        <div class="hero__centered-trust">
          <span class="dot"></span>
          <span>Planos a partir de <b>R$&nbsp;24,00/mês</b> por cliente · descontos a partir de 50&nbsp;clientes</span>
        </div>
      </div>

      <div class="hero__glow"></div>
      <div class="container hero__shot-wrap">
        <div class="hero__shot">
          <div class="mockup__chrome">
            <span class="dot r"></span>
            <span class="dot y"></span>
            <span class="dot g"></span>
            <span class="url">app.sencon.com.br / clientes</span>
          </div>
          <img
            src="/assets/home-sencon.png"
            alt="Painel da Sencon para assessores e contadores"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- ── Social proof ─────────────────────────────────── -->
    <Numbers />

    <!-- ── Benefits triptych ────────────────────────────── -->
    <section class="section section--dark section--features">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Por que a Sencon</span>
          <h2>Tudo o que seu escritório precisa para cuidar do IR dos clientes.</h2>
          <p>Ofereça o melhor serviço em Imposto de Renda sobre renda variável — sem planilhas e sem retrabalho.</p>
        </div>

        <div class="cf-grid">
          {benefits.map((b) => (
            <div class="cf-grid__col">
              <div class="cf-grid__illo">
                {b.illo === 'auto' && (
                  <svg class="illo" viewBox="0 0 300 184" fill="none" aria-hidden="true">
                    <line class="s-soft" x1="26" y1="78" x2="74" y2="78" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="26" y1="92" x2="64" y2="92" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="26" y1="106" x2="74" y2="106" stroke-width="3" stroke-linecap="round" />
                    <path class="s-acc" d="M82 92 L116 92" stroke-width="1.5" stroke-dasharray="4 5" />
                    <circle class="illo-pulse f-acc" r="3.5" style="offset-path: path('M82 92 L116 92');" />
                    <rect class="f-chip s-line" x="120" y="58" width="68" height="68" rx="12" stroke-width="1.5" />
                    <rect class="s-acc" x="138" y="76" width="32" height="32" rx="6" stroke-width="1.5" />
                    <g><line class="s-line" x1="112" y1="68" x2="120" y2="68" stroke-width="1.5" /><line class="s-line" x1="188" y1="68" x2="196" y2="68" stroke-width="1.5" /></g>
                    <g><line class="s-line" x1="112" y1="92" x2="120" y2="92" stroke-width="1.5" /><line class="s-line" x1="188" y1="92" x2="196" y2="92" stroke-width="1.5" /></g>
                    <g><line class="s-line" x1="112" y1="116" x2="120" y2="116" stroke-width="1.5" /><line class="s-line" x1="188" y1="116" x2="196" y2="116" stroke-width="1.5" /></g>
                    <g><line class="s-line" x1="140" y1="50" x2="140" y2="58" stroke-width="1.5" /><line class="s-line" x1="140" y1="126" x2="140" y2="134" stroke-width="1.5" /></g>
                    <g><line class="s-line" x1="154" y1="50" x2="154" y2="58" stroke-width="1.5" /><line class="s-line" x1="154" y1="126" x2="154" y2="134" stroke-width="1.5" /></g>
                    <g><line class="s-line" x1="168" y1="50" x2="168" y2="58" stroke-width="1.5" /><line class="s-line" x1="168" y1="126" x2="168" y2="134" stroke-width="1.5" /></g>
                    <path class="s-grn" d="M192 92 L226 92" stroke-width="1.5" stroke-dasharray="4 5" />
                    <circle class="f-grntint s-grn" cx="248" cy="92" r="18" stroke-width="1.5" />
                    <path class="s-grn" d="M240 92 l5 6 9 -11" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {b.illo === 'reports' && (
                  <svg class="illo" viewBox="0 0 300 184" fill="none" aria-hidden="true">
                    <rect class="f-chip s-soft" x="44" y="26" width="212" height="132" rx="12" stroke-width="1.5" />
                    <line class="s-line" x1="66" y1="120" x2="66" y2="100" stroke-width="8" stroke-linecap="round" />
                    <line class="s-line" x1="92" y1="120" x2="92" y2="86" stroke-width="8" stroke-linecap="round" />
                    <line class="s-line" x1="118" y1="120" x2="118" y2="94" stroke-width="8" stroke-linecap="round" />
                    <line class="s-acc" x1="144" y1="120" x2="144" y2="66" stroke-width="8" stroke-linecap="round" />
                    <path class="s-acc" d="M64 96 L90 82 L116 90 L144 58 L196 48" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.9" />
                    <circle class="illo-pulse f-acc" r="3.5" style="offset-path: path('M64 96 L90 82 L116 90 L144 58 L196 48');" />
                    <circle class="f-grn" cx="196" cy="48" r="4" />
                    <line class="s-soft" x1="178" y1="100" x2="236" y2="100" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="178" y1="114" x2="222" y2="114" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="178" y1="128" x2="232" y2="128" stroke-width="3" stroke-linecap="round" />
                  </svg>
                )}
                {b.illo === 'support' && (
                  <svg class="illo" viewBox="0 0 300 184" fill="none" aria-hidden="true">
                    <rect class="f-chip s-line" x="44" y="34" width="156" height="92" rx="16" stroke-width="1.5" />
                    <path class="s-line" d="M80 126 L80 150 L106 126" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
                    <line class="s-soft" x1="68" y1="64" x2="176" y2="64" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="68" y1="82" x2="150" y2="82" stroke-width="3" stroke-linecap="round" />
                    <line class="s-soft" x1="68" y1="100" x2="164" y2="100" stroke-width="3" stroke-linecap="round" />
                    <circle class="f-grntint s-grn" cx="228" cy="118" r="26" stroke-width="1.5" />
                    <path class="s-grn" d="M216 118 l8 9 14 -17" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    <path class="s-acc" d="M200 92 C214 98 222 104 226 112" stroke-width="1.5" stroke-dasharray="4 5" />
                    <circle class="illo-pulse f-acc" r="3.5" style="offset-path: path('M200 92 C214 98 222 104 226 112');" />
                  </svg>
                )}
              </div>
              <div class="cf-grid__text">
                <h4>{b.title}</h4>
                <p>{b.desc}</p>
              </div>
            </div>
          ))}

          <span class="cf-x" style="left: 0%; top: 0%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 100%; top: 0%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 0%; top: 100%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 100%; top: 100%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 33.3333%; top: 0%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 66.6667%; top: 0%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 33.3333%; top: 100%;" aria-hidden="true"></span>
          <span class="cf-x" style="left: 66.6667%; top: 100%;" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <!-- ── How it works ─────────────────────────────────── -->
    <section class="section section--gray flowsec">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Como funciona</span>
          <h2>Trabalhar com a Sencon é simples.</h2>
          <p>Cada cliente com a própria conta, tudo organizado — e quanto mais a sua carteira cresce, mais você economiza.</p>
        </div>

        <div class="flow">
          <div class="flow-steps">
            <div class="flow-step">
              <div class="flow-step__num">01</div>
              <div>
                <div class="flow-step__t">Uma conta por cliente</div>
                <div class="flow-step__d">Cada cliente tem a própria conta na plataforma por R$&nbsp;24,00/mês, com tudo separado e organizado.</div>
              </div>
            </div>
            <div class="flow-step">
              <div class="flow-step__num">02</div>
              <div>
                <div class="flow-step__t">Clientes no controle</div>
                <div class="flow-step__d">Seus clientes administram as próprias contas e acompanham a tributação — você foca no relacionamento.</div>
              </div>
            </div>
            <div class="flow-step">
              <div class="flow-step__num">03</div>
              <div>
                <div class="flow-step__t">Cresça com descontos</div>
                <div class="flow-step__d">A partir de 50 clientes pagantes, todos passam a receber descontos nos nossos serviços.</div>
              </div>
            </div>
          </div>

          <div class="adv-note">
            <span class="check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <div><b>50+ clientes pagantes</b> — descontos progressivos para toda a sua carteira, além de atendimento prioritário com nosso time.</div>
          </div>
        </div>

        <div class="steps-cta adv-highlight">
          <div class="steps-cta__txt">
            <div class="t">Já atende uma carteira de investidores?</div>
            <div class="d">Fale com um especialista e descubra o desconto ideal para o tamanho do seu escritório.</div>
          </div>
          <a href="#" class="btn btn--whatsapp btn--lg" id="adv-howto-especialista">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3c.2.2 2.1 3.2 5.2 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4 0-.2-.3-.3-.6-.5zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.4.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
            Falar com um especialista
          </a>
        </div>
      </div>
    </section>

    <!-- ── Plans ────────────────────────────────────────── -->
    <section class="section section--light" id="planos">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Planos</span>
          <h2>Comece com o que precisa, cresça com a gente.</h2>
          <p>Uma conta por cliente, com tudo incluído — e condições especiais quando a sua carteira aumenta.</p>
        </div>

        <div class="plans">
          <article class="plan plan--featured">
            <span class="plan__tag">Por cliente</span>
            <div class="plan__head">
              <div class="plan__flag">👥</div>
              <div>
                <div class="plan__title">Conta do cliente</div>
                <div style="font-size: 12.5px; color: var(--fg-muted); margin-top: 2px;">Tudo organizado, cliente a cliente</div>
              </div>
            </div>
            <p class="plan__sub">Cada cliente com a própria conta na plataforma.</p>
            <div class="plan__price">
              <span class="currency">R$</span>
              <span class="amount">24</span>
              <span class="cents">,00</span>
              <span class="period">/mês</span>
            </div>
            <ul>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Cálculo de IR sobre renda variável (B3)</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Geração de DARF e auxílio à declaração anual</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Relatórios de carteira: lucro, corretagem e preço médio</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>O cliente administra a própria conta</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Suporte técnico especializado na plataforma</li>
            </ul>
            <a href="#" class="btn btn--primary" id="adv-plan-cta">Contratar agora</a>
          </article>

          <article class="plan">
            <div class="plan__head">
              <div class="plan__flag">🚀</div>
              <div>
                <div class="plan__title">Parceria 50+</div>
                <div style="font-size: 12.5px; color: var(--fg-muted); margin-top: 2px;">Para escritórios em crescimento</div>
              </div>
            </div>
            <p class="plan__sub">A partir de 50 clientes pagantes, com condições sob medida.</p>
            <div class="plan__price">
              <span class="amount" style="font-size: 40px;">Sob</span>
              <span class="period">consulta</span>
            </div>
            <ul>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Descontos progressivos para toda a carteira</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Tudo do plano por cliente, sem limites</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Atendimento prioritário com nosso time</li>
              <li><span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>Soluções personalizadas para o seu escritório</li>
            </ul>
            <a href="#" class="btn btn--secondary" id="adv-plan-vendas">Falar com vendas</a>
          </article>
        </div>

        <div class="plan-extras">
          <div class="item">
            <span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <div><b>Atendimento especializado</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Analistas focados em renda variável.</span></div>
          </div>
          <div class="item">
            <span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <div><b>Carteira sempre organizada</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Cada cliente separado, do jeito certo.</span></div>
          </div>
          <div class="item">
            <span class="check"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <div><b>Cresceu, economizou</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Descontos a partir de 50 clientes.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────────────────── -->
    <section class="section section--light">
      <div class="container">
        <div class="sec-head">
          <span class="eyebrow">Dúvidas frequentes</span>
          <h2>Perguntas de quem atende investidores.</h2>
        </div>

        <div class="faq">
          <details class="faq__item" open>
            <summary>Como funciona a cobrança por cliente?</summary>
            <p>Cada cliente possui a própria conta na plataforma, com o custo de R$&nbsp;24,00/mês. Assim, todas as informações ficam separadas e organizadas, e o próprio cliente pode administrar a conta e a própria tributação.</p>
          </details>
          <details class="faq__item">
            <summary>Quais descontos eu tenho conforme cresço?</summary>
            <p>A partir de 50 clientes pagantes, todos passam a receber descontos nos nossos serviços. Quanto maior a sua carteira, melhores as condições — fale com um especialista para conhecer os valores.</p>
          </details>
          <details class="faq__item">
            <summary>O que está incluído no serviço?</summary>
            <p>Cálculo automático do IR sobre renda variável, geração de DARF, auxílio à declaração anual e relatórios de carteira com lucro, taxas de corretagem e preço médio — tudo para você acompanhar e fidelizar seus clientes.</p>
          </details>
          <details class="faq__item">
            <summary>E se eu ou meu cliente tivermos dúvidas?</summary>
            <p>Você conta com suporte técnico especializado dentro da própria plataforma. Se seu cliente fez uma pergunta e você não sabe a resposta, nosso time ajuda você a resolver.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ── Final CTA ────────────────────────────────────── -->
    <section class="section section--light">
      <div class="container">
        <div class="finalcta">
          <div>
            <span class="eyebrow" style="color: #6B9DFF;">Soluções personalizadas</span>
            <h2 style="margin-top: 16px;">Vamos montar o plano ideal para o seu escritório.</h2>
