<!-- This persona's photo has the subject on the right, so pull the crop toward
     the subject's face (default crop is centered for the assessores photo). -->
<style>
  .persona-hero__photo { object-position: 64% 30%; }
  @media (max-width: 1024px) { .persona-hero__photo { object-position: 60% 26%; } }
</style>

<script is:inline>
  /* ── FAQ accordion ── */
  ;(function () {
    const root = document.getElementById('pp-faq')
    if (!root) return
    const items = Array.from(root.querySelectorAll('.pp-faq__item'))
    items.forEach((item) => {
      const q = item.querySelector('.pp-faq__q')
      const a = item.querySelector('.pp-faq__a')
      q?.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === '1'
        items.forEach((it) => {
          it.setAttribute('data-open', '0')
          it.querySelector('.pp-faq__q')?.setAttribute('aria-expanded', 'false')
          const aa = it.querySelector('.pp-faq__a')
          if (aa) aa.style.maxHeight = '0px'
        })
        if (!isOpen) {
          item.setAttribute('data-open', '1')
          q.setAttribute('aria-expanded', 'true')
          if (a) a.style.maxHeight = '320px'
        }
      })
    })
  })()

  /* ── PostHog tracking ── */
  ;(function () {
    const track = (id, ev) =>
      document.getElementById(id)?.addEventListener('click', () =>
        window.posthog?.capture(ev, { page: 'investidores' })
      )
    track('inv-hero-start', 'investors_hero_start_clicked')
    track('inv-hero-plans', 'investors_hero_plans_clicked')
    track('inv-flow-start', 'investors_flow_start_clicked')
    track('inv-plan-start', 'investors_plan_start_clicked')
    track('inv-plan-premium', 'investors_plan_premium_clicked')
    track('inv-final-start', 'investors_final_start_clicked')
    track('inv-final-plans', 'investors_final_plans_clicked')
  })()
</script>
