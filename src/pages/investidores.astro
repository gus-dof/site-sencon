---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Numbers from '../components/Numbers.astro'
import Footer from '../components/Footer.astro'
import FabWhats from '../components/FabWhats.astro'

const title = 'Sencon para Investidores · Imposto de Renda de investimentos no automático'
const description =
  'Do investidor casual ao trader ativo: a Sencon apura o IR dos seus investimentos na B3 e no exterior, emite o DARF e organiza a declaração. Importe as notas das corretoras, confira a custódia e feche o mês sem planilha e sem risco de multa.'

/* ── Line-icon set (matches the pp-* design system) ─────────────────── */
const icons: Record<string, string> = {
  ChevronR: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>',
  Check: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  Star: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>',
  ArrowRight: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>',
  Calculator: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><circle cx="8" cy="11" r="0.6" fill="currentColor"/><circle cx="12" cy="11" r="0.6" fill="currentColor"/><circle cx="16" cy="11" r="0.6" fill="currentColor"/><circle cx="8" cy="15" r="0.6" fill="currentColor"/><circle cx="12" cy="15" r="0.6" fill="currentColor"/><line x1="16" y1="14" x2="16" y2="18"/></svg>',
  Globe: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  Receipt: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2z"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/></svg>',
  Upload: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>',
  BarChart: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/></svg>',
  FileText: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>',
  ShieldCheck: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11.5 14.5 16 9.5"/></svg>',
  Eye: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
  Activity: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
}

const LOGIN = 'https://ir.sencon.com.br/login'
const SIGNUP = 'https://ir.sencon.com.br/sign-up'

/* ── "Feito para quem…" — dores da persona ──────────────────────────── */
const pains = [
  { n: '01', t: 'A planilha nunca fecha', d: 'Calcular preço médio, prejuízo acumulado e o imposto de cada operação na mão consome horas, e quase nunca bate no fim.' },
  { n: '02', t: 'Medo de cair na malha fina', d: 'Um DARF esquecido ou um cálculo errado viram juros, multa e dor de cabeça com a Receita Federal.' },
  { n: '03', t: 'Cada ativo tem uma regra', d: 'Ações, FIIs, ETFs, opções e day trade misturam alíquotas e prazos diferentes. É fácil se perder.' },
  { n: '04', t: 'O exterior assusta', d: 'Dólar, câmbio PTAX e a nova lei dos investimentos lá fora parecem um bicho de sete cabeças.' },
]

/* ── Recursos relevantes para a persona ─────────────────────────────── */
const recursos = [
  { ico: 'Calculator', t: 'Apuração automática na B3', d: 'Ações, FIIs, ETFs, opções e day trade apurados mês a mês, sem você tocar numa planilha.', chip: 'B3' },
  { ico: 'Globe', t: 'IR no exterior', d: 'Ações, ETFs e dividendos lá fora, com câmbio PTAX e a Lei 14.754/23 aplicados sozinhos.', chip: 'Exterior' },
  { ico: 'Receipt', t: 'DARF em um clique', d: 'O DARF sai pronto para pagar, com juros e multa calculados automaticamente quando há atraso.' },
  { ico: 'Upload', t: 'Importação de notas', d: 'Importe notas no padrão SINACOR ou conecte as suas corretoras direto na plataforma.' },
  { ico: 'BarChart', t: 'Controle da carteira', d: 'Acompanhe lucro, prejuízo, preço médio e a evolução dos seus investimentos em um painel.' },
  { ico: 'FileText', t: 'Pronto para declarar', d: 'No fim do ano, relatórios organizados para a declaração anual, para você ou para o seu contador.' },
]

/* ── Como a Sencon resolve (esteira / passos) ───────────────────────── */
const steps = [
  { n: '01', ico: 'Upload', t: 'Importe as notas', d: 'Suba seus arquivos SINACOR ou conecte a corretora, sem digitar um número sequer.' },
  { n: '02', ico: 'Eye', t: 'Confira a custódia', d: 'A Sencon organiza posições, preço médio e eventos. Você só valida o que já está pronto.' },
  { n: '03', ico: 'Calculator', t: 'Apure e emita o DARF', d: 'O imposto é calculado e o DARF sai pronto para pagar, no código certo de cada operação.' },
  { n: '04', ico: 'FileText', t: 'Declare sem susto', d: 'No fim do ano, baixe o relatório com tudo organizado para a declaração anual.' },
]

/* ── Depoimentos de quem tem esse perfil ────────────────────────────── */
const testimonials = [
  { quote: 'Eu fazia tudo no Excel e vivia com medo de errar. Importei minhas notas e a Sencon calculou meses de uma vez. Nunca mais toquei numa planilha de IR.', name: 'Rafael Moreira', role: 'Investidor pessoa física · B3' },
  { quote: 'Comecei a investir no exterior e travei na hora do imposto. A Sencon resolveu o câmbio e o DARF sem eu precisar entender nada de PTAX.', name: 'Camila Restrepo', role: 'Investidora · B3 e exterior' },
]
const initials = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((s) => s[0]).join('')

/* ── FAQ ─────────────────────────────────────────────────────────────── */
const faq = [
  { q: 'Preciso entender de imposto para usar?', a: 'Não. A Sencon apura o imposto, aplica as regras de cada tipo de investimento e emite o DARF automaticamente. Você importa as notas, confere e pronto, sem decorar alíquota nem prazo.' },
  { q: 'Quais investimentos a Sencon cobre?', a: 'Renda variável na B3 (ações, FIIs, ETFs, opções e day trade) e investimentos no exterior (ações, ETFs e dividendos), com câmbio PTAX e a Lei 14.754/23 aplicados automaticamente.' },
  { q: 'A Sencon emite o DARF para mim?', a: 'Sim. Geramos o DARF no código certo de cada situação, com juros e multa calculados automaticamente quando há atraso. É só baixar e pagar.' },
  { q: 'Funciona para day trade?', a: 'Funciona. A apuração separa day trade de swing trade, aplica a alíquota correta e considera o IRRF (dedo-duro) retido na fonte, mês a mês.' },
  { q: 'E a declaração anual?', a: 'No fim do ano você baixa relatórios já organizados com bens e direitos, rendimentos e o resumo do ano, prontos para você ou o seu contador preencherem a declaração.' },
]

/* ── Outras soluções / personas (rodapé) ────────────────────────────── */
const personas = [
  { k: 'Produto', t: 'IR na B3', d: 'Apuração mensal de ações, FIIs, ETFs, opções e day trade na bolsa brasileira.', photo: 'casual', alt: 'Investidor acompanhando a carteira pelo celular', href: '/ir-b3' },
  { k: 'Produto', t: 'IR no Exterior', d: 'Imposto sobre ações, ETFs e dividendos lá fora, com câmbio PTAX e Lei 14.754/23.', photo: 'trader', alt: 'Investidora analisando ativos internacionais', href: '/ir-exterior' },
  { k: 'Solução', t: 'Para assessores e contadores', d: 'Gerencie o IR de toda a sua carteira de clientes em um só painel.', photo: 'assessor', alt: 'Assessor de investimentos usando o celular', href: '/assessores' },
]
---
<Layout title={title} description={description}>
  <Navbar />
  <main>
    <!-- ═══ 01 · Persona hero (split, foto sangra à direita) ═══════════ -->
    <section class="persona-hero">
      <div class="persona-hero__grain" aria-hidden="true"></div>
      <div class="persona-hero__media" aria-hidden="true">
        <img class="persona-hero__photo" src="/assets/personas/investidor.jpg" alt="Investidor de óculos observando gráficos de mercado em uma tela" loading="eager" />
      </div>
      <div class="container">
        <div class="persona-hero__inner">
          <span class="pp-eyebrow persona-hero__eyebrow">
            <span class="idx">Soluções</span><span class="sep"></span> Para investidores
          </span>
          <h1 class="persona-hero__title">
            Seu foco é investir. O Imposto de Renda é <span class="accent">com a Sencon.</span>
          </h1>
          <p class="persona-hero__sub">
            Importe as notas das suas corretoras, confira a custódia e emita o DARF em poucos cliques.
            Do investidor casual ao trader ativo, na B3 e no exterior, sem planilha e sem risco de multa.
          </p>
          <div class="persona-hero__cta">
            <a href={SIGNUP} target="_blank" rel="noopener" class="btn btn--primary btn--lg" id="inv-hero-start">
              Começar agora <Fragment set:html={icons.ChevronR} />
            </a>
            <a href="#planos" class="btn btn--ghost-dark btn--lg" id="inv-hero-plans">Ver planos</a>
          </div>
          <div class="persona-hero__trust">
            <span><b>+300 mil</b> investidores</span>
            <span class="persona-hero__sep" aria-hidden="true"></span>
            <span><b>16 anos</b> de mercado</span>
            <span class="persona-hero__sep" aria-hidden="true"></span>
            <span>cálculo para <b>B3 e Exterior</b></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 02 · Dores da persona ("Feito para quem…") ════════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">1.0</span> Para quem é</span>
          <h2>Feito para quem investe e não quer dor de cabeça com o IR.</h2>
          <p>Se você investe na bolsa ou no exterior, provavelmente já passou por alguma destas situações:</p>
        </div>
        <div class="fx-blurbs">
          {pains.map((p) => (
            <div class="fx-blurb">
              <h4><span class="n">{p.n}</span> {p.t}</h4>
              <p>{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 03 · Recursos relevantes para a persona ═══════════════════ -->
    <section class="pp-section section--gray">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">2.0</span> Recursos</span>
          <h2>Tudo para fechar o seu IR, sem planilha.</h2>
          <p>Da importação das notas ao relatório da declaração anual, com cada tipo de investimento no lugar certo.</p>
        </div>
        <div class="pp-featlist">
          {recursos.map((r) => (
            <div class="pp-featitem">
              <div class="pp-featitem__h">
                <span class="pp-featitem__ico"><Fragment set:html={icons[r.ico]} /></span>
                <h4>{r.t}</h4>
              </div>
              <p>{r.d}</p>
              {r.chip && <span class="pp-featitem__chip">{r.chip}</span>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 04 · Como a Sencon resolve (esteira / passos) ═════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">3.0</span> Como funciona</span>
          <h2>Seu IR fechado em 4 passos.</h2>
          <p>Você importa as notas. A Sencon calcula, gera o DARF e deixa tudo pronto para a declaração.</p>
        </div>
        <div class="adv-flow">
          {steps.map((s) => (
            <div class="adv-step">
              <div class="adv-step__top">
                <span class="adv-step__ico"><Fragment set:html={icons[s.ico]} /></span>
                <span class="adv-step__n">{s.n}</span>
              </div>
              <h4>{s.t}</h4>
              <p>{s.d}</p>
            </div>
          ))}
        </div>

        <div class="adv-cta">
          <div class="adv-cta__txt">
            <div class="t">Quer ver funcionando com as suas notas?</div>
            <div class="d">Crie a sua conta, importe os arquivos da sua corretora e veja o imposto calculado em minutos.</div>
          </div>
          <a href={SIGNUP} target="_blank" rel="noopener" class="btn btn--primary btn--lg" id="inv-flow-start">
            Começar agora <Fragment set:html={icons.ChevronR} />
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ 05 · Planos sugeridos ═════════════════════════════════════ -->
    <section class="pp-section section--gray" id="planos">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">4.0</span> Planos</span>
          <h2>Escolha como quer cuidar do seu IR.</h2>
          <p>Apure você mesmo, no seu ritmo, ou deixe um analista Sencon fechar tudo por você.</p>
        </div>

        <div class="plans">
          <article class="plan">
            <div class="plan__head">
              <span class="plan__flag"><Fragment set:html={icons.Calculator} /></span>
              <span class="plan__title">Faça você mesmo</span>
            </div>
            <p class="plan__sub">Para quem quer apurar o IR sozinho, na B3 e no exterior, sem planilha.</p>
            <div class="plan__price">
              <span class="currency">R$</span><span class="amount">49</span><span class="cents">,90</span><span class="period">/mês</span>
            </div>
            <ul>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Apuração de ações, FIIs, ETFs, opções e day trade</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Investimentos no exterior com câmbio PTAX</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Geração ilimitada de DARFs</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Controle de carteira e relatórios da declaração</li>
            </ul>
            <a href={SIGNUP} target="_blank" rel="noopener" class="btn btn--secondary btn--lg" id="inv-plan-start">Começar agora</a>
          </article>

          <article class="plan plan--featured">
            <span class="plan__tag">Mais escolhido</span>
            <div class="plan__head">
              <span class="plan__flag"><Fragment set:html={icons.ShieldCheck} /></span>
              <span class="plan__title">Premium</span>
            </div>
            <p class="plan__sub">Um analista Sencon fecha seus meses e cuida da declaração de ponta a ponta.</p>
            <div class="plan__price">
              <span class="currency">R$</span><span class="amount">119</span><span class="cents">,90</span><span class="period">/mês</span>
            </div>
            <ul>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Tudo do plano Faça você mesmo</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Um analista busca suas notas e apura por você</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> DARFs emitidos mensalmente, sem você lembrar</li>
              <li><span class="check"><Fragment set:html={icons.Check} /></span> Declaração anual completa incluída</li>
            </ul>
            <a href="#" class="btn btn--primary btn--lg" id="inv-plan-premium">Falar com especialista</a>
          </article>
        </div>

        <div class="plan-extras">
          <div class="item">
            <span class="check"><Fragment set:html={icons.Check} /></span>
            <div><b>Sem cartão para começar</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Teste sem compromisso.</span></div>
          </div>
          <div class="item">
            <span class="check"><Fragment set:html={icons.Check} /></span>
            <div><b>B3 e exterior juntos</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Tudo na mesma conta.</span></div>
          </div>
          <div class="item">
            <span class="check"><Fragment set:html={icons.Check} /></span>
            <div><b>Cancele quando quiser</b><br /><span style="color: var(--fg-muted); font-size: 13px;">Sem fidelidade ou multa.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 06 · Métricas / prova social ══════════════════════════════ -->
    <Numbers />

    <!-- ═══ 07 · Depoimento de alguém desse perfil ════════════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">5.0</span> Depoimentos</span>
          <h2>Investidores que largaram a planilha.</h2>
        </div>
        <div class="testi-summary">
          <div class="rating">4,9</div>
          <div class="meta">
            <div class="stars"><Fragment set:html={icons.Star + icons.Star + icons.Star + icons.Star + icons.Star} /></div>
            <div class="t">Excelente</div>
            <div class="d">Mais de 2.000 avaliações verificadas</div>
          </div>
        </div>
        <div class="testi">
          {testimonials.map((it) => (
            <article class="testi__card">
              <div class="testi__stars"><Fragment set:html={icons.Star + icons.Star + icons.Star + icons.Star + icons.Star} /></div>
              <p class="testi__quote">{it.quote}</p>
              <div class="testi__author">
                <div class="testi__avatar">{initials(it.name)}</div>
                <div>
                  <div class="name">{it.name}</div>
                  <div class="role">{it.role}</div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 08 · FAQ ══════════════════════════════════════════════════ -->
    <section class="pp-section section--gray">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">6.0</span> Perguntas frequentes</span>
          <h2>Ainda em dúvida?</h2>
        </div>
        <div class="pp-faq" id="pp-faq">
          {faq.map((f, i) => (
            <div class="pp-faq__item" data-open={i === 0 ? '1' : '0'}>
              <button class="pp-faq__q" aria-expanded={i === 0 ? 'true' : 'false'}>
                {f.q}
                <span class="pp-faq__icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </span>
              </button>
              <div class="pp-faq__a" style={`max-height:${i === 0 ? '320px' : '0'}`}>
                <div class="pp-faq__a-inner">{f.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 09 · Outras soluções / personas ═══════════════════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label">Continue explorando</span>
          <h2>Outras soluções Sencon.</h2>
        </div>
        <div class="fx-personas">
          {personas.map((p) => (
            <a class="fx-persona fx-persona--link" href={p.href}>
              <div class="fx-persona__media">
                <img src={`/assets/personas/${p.photo}.jpg`} alt={p.alt} loading="lazy" />
              </div>
              <div class="fx-persona__cap">
                <span class="fx-persona__k">{p.k}</span>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
                <span class="fx-persona__more">Conhecer <Fragment set:html={icons.ArrowRight} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 10 · CTA final ════════════════════════════════════════════ -->
    <section class="pp-section section--light" style="padding-top:0">
      <div class="container">
        <div class="finalcta">
          <div>
            <span class="eyebrow" style="color:#6B9DFF">Comece hoje mesmo</span>
            <h2 style="margin-top:16px">Pronto para fechar seu IR sem planilha?</h2>
            <p>Importe as notas, feche o mês e emita o DARF em poucos cliques. Sem planilhas, sem erros e sem surpresa na Receita Federal.</p>
          </div>
          <div class="finalcta__actions">
