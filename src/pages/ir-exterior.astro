---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import FabWhats from '../components/FabWhats.astro'

const title = 'Sencon · IR Exterior — Imposto de Renda de investimentos no exterior, no automático'
const description =
  'IR Exterior da Sencon: cálculo automático de Imposto de Renda para ações, ETFs, REITs, dividendos e aplicações financeiras no exterior. Câmbio PTAX e Lei 14.754/23 aplicados sozinhos, com DARF emitido — sem planilha de dólar.'

/* ── Line-icon set (matches the design system) ───────────────────── */
const icons: Record<string, string> = {
  ChevronR: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>',
  Check: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  Star: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>',
  Globe: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  FileText: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>',
  Calculator: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><circle cx="8" cy="11" r="0.6" fill="currentColor"/><circle cx="12" cy="11" r="0.6" fill="currentColor"/><circle cx="16" cy="11" r="0.6" fill="currentColor"/><circle cx="8" cy="15" r="0.6" fill="currentColor"/><circle cx="12" cy="15" r="0.6" fill="currentColor"/><line x1="16" y1="14" x2="16" y2="18"/></svg>',
  BarChart: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/></svg>',
  Upload: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>',
  Eye: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
  Download: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
  Layers: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  Bolt: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  Link: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
  ShieldCheck: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11.5 14.5 16 9.5"/></svg>',
  Receipt: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2z"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/></svg>',
  ArrowRight: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>',
  Activity: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  DollarSign: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
  RefreshCw: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>',
}

/* ── Premium "technical" placeholder shots ───────────────────────── */
const X = '<span class="cf-x tl"></span><span class="cf-x tr"></span><span class="cf-x bl"></span><span class="cf-x br"></span>'
function shotPanel(o: { label: string; note?: string; dim?: string; icon?: string; minHeight?: number }) {
  const ic = icons[o.icon || 'Eye']
  return `<div class="ppshot showcase__shot"${o.minHeight ? ` style="min-height:${o.minHeight}px"` : ''}>${X}
    <div class="ppshot__tag">
      <span class="ppshot__chip">${ic}${o.label}</span>
      ${o.note ? `<span class="ppshot__note">${o.note}</span>` : ''}
      ${o.dim ? `<span class="ppshot__dim">${o.dim}</span>` : ''}
    </div>
  </div>`
}
function shotFrame(o: { url?: string; label: string; note?: string; dim?: string; icon?: string; height?: number }) {
  const url = o.url || 'app.sencon.com.br/ir-exterior'
  const h = o.height || 440
  const ic = icons[o.icon || 'Eye']
  return `<div class="scframe showcase__shot">
    <div class="mockup__chrome">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="url">${url}</span>
    </div>
    <div class="ppshot" style="border:0;border-radius:0;min-height:${h}px">${X}
      <div class="ppshot__tag">
        <span class="ppshot__chip">${ic}${o.label}</span>
        ${o.note ? `<span class="ppshot__note">${o.note}</span>` : ''}
        ${o.dim ? `<span class="ppshot__dim">${o.dim}</span>` : ''}
      </div>
    </div>
  </div>`
}

/* ── Corretoras do exterior (hero strip) ─────────────────────────── */
const brokers = [
  { name: 'Avenue', logo: 'avenue' },
  { name: 'Nomad', logo: 'nomad' },
  { name: 'Interactive Brokers', logo: 'ibkr' },
  { name: 'Morgan Stanley', logo: 'morganstanley' },
  { name: 'Charles Schwab', logo: 'schwab' },
]
/* The marquee animates translateX(-50%), so it only loops seamlessly when
   one half of the track is wider than the viewport. With few brokers we
   repeat the list so each half stays wide enough. */
const marqueeHalf = [...brokers, ...brokers]
const marqueeItems = [...marqueeHalf, ...marqueeHalf]

/* ── Content arrays ──────────────────────────────────────────────── */
const fxBlurbs = [
  { n: '01', t: 'Lei 14.754/23 aplicada', d: 'Aplicações financeiras, offshore e trusts tributados pelas novas regras — sem você decorar artigo.' },
  { n: '02', t: 'Câmbio PTAX automático', d: 'Cada operação convertida pela cotação oficial do Banco Central — compra e venda — sem busca manual.' },
  { n: '03', t: 'Ganho de capital e dividendos', d: 'Venda de ações, ETFs e REITs e os dividendos recebidos lá fora, cada um no seu imposto.' },
  { n: '04', t: 'Prejuízo que compensa', d: 'Perdas em aplicações financeiras abatem ganhos do mesmo tipo, dentro do que a lei permite.' },
]
const fxAssets = [
  { ico: 'BarChart', t: 'Ações US', k: 'Stocks & ADRs' },
  { ico: 'Activity', t: 'ETFs', k: 'Índice no exterior' },
  { ico: 'Layers', t: 'REITs', k: 'Fundos imobiliários' },
  { ico: 'DollarSign', t: 'Dividendos', k: 'Recebidos lá fora' },
  { ico: 'Bolt', t: 'Aplicações', k: 'Alíquota de 15%' },
  { ico: 'Calculator', t: 'Ganho de capital', k: 'Venda de bens' },
  { ico: 'Globe', t: 'Offshore', k: 'Entidades controladas' },
  { ico: 'ShieldCheck', t: 'Trust', k: 'Patrimônio no exterior' },
  { ico: 'RefreshCw', t: 'Câmbio PTAX', k: 'Compra & venda' },
  { ico: 'Receipt', t: 'Carnê-leão', k: 'Rendimentos mensais' },
]

const fxUseCases = [
  { t: 'Aplicações financeiras (anual)', d: 'Apure os 15% sobre aplicações financeiras no exterior, com câmbio PTAX, prontos para a declaração anual.', label: 'screenshot · Aplicações no exterior', icon: 'DollarSign' },
  { t: 'Ganho de capital na venda', d: 'Vendeu ações ou ETFs lá fora? Calculamos o ganho de capital convertido em reais e geramos o DARF.', label: 'screenshot · Ganho de capital', icon: 'Calculator' },
  { t: 'Dividendos e carnê-leão', d: 'Dividendos recebidos no exterior entram no carnê-leão automaticamente, mês a mês, sem cálculo manual.', label: 'screenshot · Carnê-leão', icon: 'Receipt' },
]

const fxPersonas = [
  { k: 'Perfil 01', t: 'Investidor global', d: 'Tem ações e ETFs na Avenue ou Nomad e quer declarar o exterior sem virar especialista em câmbio.', photo: 'casual', alt: 'Investidor global sorrindo' },
  { k: 'Perfil 02', t: 'Trader internacional', d: 'Opera ativos lá fora com frequência e precisa do ganho de capital e do carnê-leão sempre em dia.', photo: 'trader', alt: 'Trader internacional em ambiente de trabalho' },
  { k: 'Perfil 03', t: 'Patrimônio offshore', d: 'Tem offshore, trust ou aplicações maiores e quer a Lei 14.754/23 aplicada sem risco.', photo: 'multi', alt: 'Investidora com patrimônio offshore' },
]

const fxPosts = [
  { tag: 'Guia', t: 'Como declarar ações e ETFs no exterior no Imposto de Renda', label: 'capa · Guia do exterior', icon: 'FileText' },
  { tag: 'Lei 14.754', t: 'A nova lei dos investimentos no exterior: o que muda na sua declaração', label: 'capa · Lei 14.754/23', icon: 'ShieldCheck' },
  { tag: 'Câmbio', t: 'Câmbio PTAX: como converter seus dólares para apurar o IR', label: 'capa · Câmbio PTAX', icon: 'RefreshCw' },
]

const testimonials = [
  { quote: 'Eu não fazia ideia de como declarar minha conta na Avenue. A Sencon converteu tudo pela PTAX e gerou o DARF. Resolveu.', name: 'Marina Salles', role: 'Investidora no exterior · ações e ETFs' },
  { quote: 'A nova lei me deixou perdido. A Sencon aplicou a 14.754 sozinha e me mostrou exatamente o que eu tinha que pagar.', name: 'Rodrigo Penna', role: 'Investidor · offshore' },
]
const initials = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((s) => s[0]).join('')

const faq = [
  { q: 'Preciso entender da Lei 14.754/23 para usar?', a: 'Não. A Sencon aplica as novas regras de tributação de investimentos no exterior automaticamente. Você importa os extratos, confere e emite o DARF — sem precisar saber alíquotas, prazos ou interpretar a lei.' },
  { q: 'Quais investimentos no exterior são cobertos?', a: 'Ações, ETFs, REITs e ADRs, dividendos, aplicações financeiras, ganho de capital na venda de bens, além de offshore, entidades controladas e trusts. Tudo convertido em reais e tributado conforme a regra de cada tipo.' },
  { q: 'Como funciona a conversão de câmbio?', a: 'Usamos a cotação PTAX oficial do Banco Central — de compra ou de venda conforme a operação e a data — para converter cada movimentação em dólar (ou outra moeda) para reais. Você não precisa caçar a cotação do dia.' },
  { q: 'A Sencon emite o DARF para mim?', a: 'Sim. Geramos o DARF no código correto para cada situação: ganho de capital, carnê-leão sobre dividendos ou aplicações financeiras. Se houver atraso, calculamos juros e multa automaticamente.' },
  { q: 'E quem tem offshore ou trust?', a: 'O plano Premium apura entidades controladas no exterior (offshore) e trusts segundo a Lei 14.754/23, com a tributação anual aplicada e o relatório pronto para a declaração — acompanhado por um especialista Sencon.' },
]

const related = [
  { idx: '01', title: 'IR B3', desc: 'Apuração de IR para ações, FIIs, ETFs, opções e day trade na bolsa brasileira.', href: '/ir-b3' },
  { idx: '03', title: 'Controle de Resultados', desc: 'Relatórios de lucro, prejuízo e DARFs emitidos para acompanhar a carteira.', href: '#' },
  { idx: '04', title: 'Contador', desc: 'A inteligência artificial da Sencon que apura impostos e tira dúvidas 24/7.', href: '/#contador' },
]
---
<Layout title={title} description={description}>
  <Navbar />
  <main>
    <!-- ═══ 01 · Hero (clean, left-aligned) ════════════════════════ -->
    <section class="pp-hero pp-hero--clean">
      <div class="pp-hero__grain"></div>
      <div class="container pp-hero__inner">
        <span class="pp-eyebrow">
          <span class="idx">01</span><span class="sep"></span> IR Exterior · Investimentos lá fora
        </span>
        <h1 class="pp-hero__title">
          Seus investimentos lá fora, <span class="accent">em dia com o Brasil.</span>
        </h1>
        <p class="pp-hero__sub">
          Da corretora no exterior ao DARF, com câmbio PTAX e a Lei 14.754/23 aplicados sozinhos. Sem planilha de dólar.
        </p>
        <div class="pp-hero__cta">
          <a href="#" class="btn btn--primary btn--lg" id="irext-hero-product">Contratar agora <Fragment set:html={icons.ChevronR} /></a>
        </div>
      </div>
      <div class="container" style="margin-top:56px">
        <div class="corretoras corretoras--on-brand">
          <div class="corretoras__label">Conectado às principais corretoras do exterior</div>
          <div class="corretoras__track">
            <div class="corretoras__marquee">
              {marqueeItems.map((b, i) => (
                <span class="corretoras__item" aria-hidden={i >= marqueeHalf.length ? 'true' : undefined}>
                  <span class="corretoras__logo">
                    <img src={`/assets/brokers/${b.logo}.png`} alt={b.name} loading="lazy" width="34" height="34" />
                  </span>
                  {b.name}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 02 · Bento — "Do extrato em dólar ao DARF" ═════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">1.0</span> Uma esteira só</span>
          <h2>Do extrato em dólar ao DARF, num só lugar.</h2>
          <p>Pare de converter câmbio na planilha e caçar a PTAX do dia. Cada etapa da apuração no exterior vive na mesma esteira — e já sai em reais.</p>
        </div>
        <div class="fx-bento">
          <div class="fx-tile fx-tile--feature">
            <div class="fx-tile__media">
              <!-- Animated "apuração" illustration -->
              <div class="bz-illo" id="bz-illo" role="img" aria-label="Ilustração: ações, ETFs e dividendos no exterior são convertidos pela PTAX, apurados e geram um DARF pronto.">
                <svg viewBox="0 0 360 332" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                  <path class="bz-edge" d="M66,58 C66,112 130,98 150,130" vector-effect="non-scaling-stroke" />
                  <path class="bz-edge" d="M165,58 C165,102 176,102 178,122" vector-effect="non-scaling-stroke" />
                  <path class="bz-edge" d="M279,58 C279,112 230,98 210,130" vector-effect="non-scaling-stroke" />
                  <path class="bz-edge" d="M180,236 L180,266" vector-effect="non-scaling-stroke" />
                  <g>
                    <rect class="bz-chip-r" x="14" y="24" width="104" height="34" rx="9" />
                    <circle class="bz-dot" cx="30" cy="41" r="3.5" />
                    <text class="bz-chip-t" x="44" y="46">Ações US</text>
                  </g>
                  <g>
                    <rect class="bz-chip-r" x="132" y="24" width="66" height="34" rx="9" />
                    <circle class="bz-dot bz-dot--2" cx="148" cy="41" r="3.5" />
                    <text class="bz-chip-t" x="162" y="46">ETFs</text>
                  </g>
                  <g>
                    <rect class="bz-chip-r" x="212" y="24" width="134" height="34" rx="9" />
                    <circle class="bz-dot bz-dot--3" cx="228" cy="41" r="3.5" />
                    <text class="bz-chip-t" x="242" y="46">Dividendos</text>
                  </g>
                  <circle class="bz-core" cx="180" cy="178" r="62" />
                  <circle class="bz-track" cx="180" cy="178" r="56" />
                  <circle class="bz-prog" id="bz-prog" cx="180" cy="178" r="56" transform="rotate(-90 180 178)" />
                  <text class="bz-val" id="bz-val" x="180" y="176" text-anchor="middle">R$ 0,00</text>
                  <text class="bz-lab" x="180" y="198" text-anchor="middle">IMPOSTO DEVIDO</text>
                  <rect class="bz-darf-r" x="110" y="270" width="140" height="42" rx="13" />
                  <path class="bz-check" d="M132,291 l5,6 l10,-12" />
                  <text class="bz-darf-t" x="162" y="296">DARF pronto</text>
                </svg>
              </div>
            </div>
            <div class="fx-tile__cap">
              <h3>Tudo conectado, ponta a ponta</h3>
              <p>Importou os extratos e o imposto já aparece em reais — com câmbio PTAX aplicado e a Lei 14.754/23 calculada automaticamente.</p>
            </div>
          </div>
          <div class="fx-tile fx-mini">
            <span class="fx-mini__ico"><Fragment set:html={icons.Upload} /></span>
            <div>
              <div class="fx-mini__t">Importar extratos</div>
              <div class="fx-mini__d">Statements das corretoras no exterior (.csv) ou sincronização.</div>
            </div>
            <span class="fx-mini__step">01</span>
          </div>
          <div class="fx-tile fx-mini">
            <span class="fx-mini__ico"><Fragment set:html={icons.RefreshCw} /></span>
            <div>
              <div class="fx-mini__t">Converter e apurar</div>
              <div class="fx-mini__d">Câmbio PTAX aplicado e imposto calculado, item a item.</div>
            </div>
            <span class="fx-mini__step">02</span>
          </div>
          <div class="fx-tile fx-mini">
            <span class="fx-mini__ico"><Fragment set:html={icons.Receipt} /></span>
            <div>
              <div class="fx-mini__t">Emitir DARF</div>
              <div class="fx-mini__d">Ganho de capital, carnê-leão ou aplicações — no código certo.</div>
            </div>
            <span class="fx-mini__step">03</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 03 · Cobertura ═════════════════════════════════════════ -->
    <section class="pp-section section--gray">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">2.0</span> Cobertura</span>
          <h2>Tudo o que o exterior gera, já coberto.</h2>
          <p>Do investidor com algumas ações na Avenue ao patrimônio com offshore: cada tipo de rendimento e cada regra da nova lei já estão na esteira, sem configuração.</p>
        </div>
        <div class="fx-blurbs">
          {fxBlurbs.map((b) => (
            <div class="fx-blurb">
              <h4><span class="n">{b.n}</span> {b.t}</h4>
              <p>{b.d}</p>
            </div>
          ))}
        </div>
        <div class="fx-assets">
          {fxAssets.map((a) => (
            <div class="fx-asset">
              <span class="fx-asset__ico"><Fragment set:html={icons[a.ico]} /></span>
              <div>
                <div class="fx-asset__t">{a.t}</div>
                <div class="fx-asset__k">{a.k}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ 04 · Casos de uso (tabs) ═══════════════════════════════ -->
    <section class="pp-section section--light">
      <div class="container">
        <div class="pp-head">
          <span class="pp-label"><span class="idx">3.0</span> Casos de uso</span>
          <h2>Transforme sua apuração num sistema.</h2>
          <p>A mesma esteira resolve as aplicações, o ganho de capital e os dividendos do exterior. Escolha um fluxo para ver como funciona.</p>
        </div>
        <div class="fx-usecases">
          <div class="fx-uc-list" role="tablist" id="fx-uc-list">
            {fxUseCases.map((u, i) => (
              <button class="fx-uc-item" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-uc={i}>
                <h4>{u.t}</h4>
                <p>{u.d}</p>
              </button>
            ))}
          </div>
          <div class="fx-uc-stage">
