<style is:global>
  /* IR B3 — testimonials summary left-aligned with the section title */
  .pp-section .testi-summary { justify-content: flex-start; text-align: left; }

  /* IR B3 — FAQ fills the full page grid (edge-to-edge), aligned with the title */
