  .pp-faq__a-inner { max-width: none; }

  /* IR B3 — investor photos fill the persona cards */
  .fx-persona__media { min-height: 240px; overflow: hidden; }
  .fx-persona__media img {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
    object-position: center 28%;
    display: block;
  }
</style>

<script
  is:inline
  define:vars={{ ucData: fxUseCases, ucIcons: Object.fromEntries(fxUseCases.map((u) => [u.icon, icons[u.icon]])) }}
>
  /* ── Use-case tabs (hover / click swaps the stage) ── */
  ;(function () {
    const list = document.getElementById('fx-uc-list')
    const stage = document.getElementById('fx-uc-stage')
    if (!list || !stage) return
    const chip = () => stage.querySelector('.ppshot__chip')
    const select = (i) => {
      list.querySelectorAll('.fx-uc-item').forEach((b, j) =>
        b.setAttribute('aria-selected', j === i ? 'true' : 'false')
      )
      const uc = ucData[i]
      const c = chip()
      if (c) c.innerHTML = (ucIcons[uc.icon] || '') + uc.label
    }
    list.querySelectorAll('.fx-uc-item').forEach((b) => {
      const i = parseInt(b.getAttribute('data-uc'), 10)
      b.addEventListener('mouseenter', () => select(i))
      b.addEventListener('click', () => select(i))
    })
  })()

  /* ── FAQ accordion ── */
  ;(function () {
    const root = document.getElementById('pp-faq')
    if (!root) return
    const items = Array.from(root.querySelectorAll('.pp-faq__item'))
    items.forEach((item) => {
      const q = item.querySelector('.pp-faq__q')
      const a = item.querySelector('.pp-faq__a')
      q?.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === '1'
        items.forEach((it) => {
          it.setAttribute('data-open', '0')
          it.querySelector('.pp-faq__q')?.setAttribute('aria-expanded', 'false')
          const aa = it.querySelector('.pp-faq__a')
          if (aa) aa.style.maxHeight = '0px'
        })
        if (!isOpen) {
          item.setAttribute('data-open', '1')
          q.setAttribute('aria-expanded', 'true')
          if (a) a.style.maxHeight = '320px'
        }
      })
    })
  })()

  /* ── Bento illustration: count-up + progress ring ── */
  ;(function () {
    const wrap = document.getElementById('bz-illo')
    const valEl = document.getElementById('bz-val')
    const prog = document.getElementById('bz-prog')
    if (!wrap || !valEl || !prog) return
    const target = 842.9
    const R = 56
    const C = 2 * Math.PI * R
    prog.setAttribute('stroke-dasharray', String(C))
    prog.setAttribute('stroke-dashoffset', String(C))
    const apply = (p) => {
      const money =
        'R$ ' + (target * p).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      valEl.textContent = money
      prog.setAttribute('stroke-dashoffset', String(C * (1 - p * 0.78)))
    }
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const animOff = document.body.getAttribute('data-illo-anim') === 'off'
    if (reduce || animOff) {
      apply(1)
      return
    }
    let started = false
    const run = () => {
      if (started) return
      started = true
      const dur = 1700
      let startT = null
      const step = (t) => {
        if (startT == null) startT = t
        const k = Math.min(1, (t - startT) / dur)
        apply(1 - Math.pow(1 - k, 3))
        if (k < 1) requestAnimationFrame(step)
      }
      requestAnimationFrame(step)
      setTimeout(() => apply(1), 2400)
    }
    const inView = () => {
      const r = wrap.getBoundingClientRect()
      return r.top < window.innerHeight && r.bottom > 0
    }
    if (inView()) run()
    try {
      const io = new IntersectionObserver(
        (e) => {
          if (e[0].isIntersecting) {
            run()
            io.disconnect()
          }
        },
        { threshold: 0.35 }
      )
      io.observe(wrap)
    } catch (_) {
      const poll = setInterval(() => {
        if (inView()) {
          run()
          clearInterval(poll)
        }
      }, 250)
    }
  })()

  /* ── PostHog tracking ── */
  ;(function () {
    const track = (id, ev, props) =>
      document.getElementById(id)?.addEventListener('click', () => window.posthog?.capture(ev, props))
    track('irb3-hero-product', 'irb3_hero_contratar_clicked')
    track('irb3-webapi-start', 'irb3_webapi_start_clicked')
    track('irb3-plan-essencial', 'irb3_plan_clicked', { plan: 'Essencial' })
    track('irb3-plan-premium', 'irb3_plan_clicked', { plan: 'Premium' })
    track('irb3-final-start', 'irb3_final_cta_clicked')
  })()
</script>
